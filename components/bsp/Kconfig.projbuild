menu "板级支持（ES3C35P）"

    menu "显示（ST77922 / QSPI）"

        config BSP_LCD_GPIO_CS
            int "片选 GPIO"
            default 10

        config BSP_LCD_GPIO_PCLK
            int "QSPI 时钟 GPIO"
            default 12

        config BSP_LCD_GPIO_D0
            int "QSPI 数据线 D0 GPIO"
            default 11

        config BSP_LCD_GPIO_D1
            int "QSPI 数据线 D1 GPIO"
            default 13

        config BSP_LCD_GPIO_D2
            int "QSPI 数据线 D2 GPIO"
            default 14

        config BSP_LCD_GPIO_D3
            int "QSPI 数据线 D3 GPIO"
            default 9

        config BSP_LCD_PIXEL_CLOCK_HZ
            int "QSPI 像素时钟（Hz）"
            default 80000000
            help
                ST77922 数据手册 V1.2 表 5 规定写模式的最小串行时钟周期
                TSCYCW = 16 ns，对应写时钟上限 62.5 MHz。厂商参考配置与
                本模块实测均使用 80 MHz，高于该限值。如需严格满足数据手册
                限值，降至 62.5 MHz 以下。详见规格书 03-display-st77922.md
                第 5.1 节。

    endmenu

    menu "背光"

        config BSP_BACKLIGHT_GPIO
            int "背光控制 GPIO"
            default 41

        config BSP_BACKLIGHT_PWM_FREQ_HZ
            int "PWM 频率（Hz）"
            default 5000

        config BSP_BACKLIGHT_PWM_RESOLUTION_BITS
            int "PWM 分辨率（位）"
            range 1 14
            default 10

    endmenu

    menu "按键"

        config BSP_BOOT_GPIO
            int "BOOT 按键 GPIO"
            default 0
            help
                BOOT 按键为 10 kΩ 上拉、按下接地。上电或复位时被拉低则进入
                下载模式，其余时间可作普通输入使用。
                注意 GPIO0 同时是启动配置（strapping）引脚，见规格书
                01-hardware.md 第 2.9 节。

    endmenu

    menu "I2C 总线"

        config BSP_I2C_GPIO_SDA
            int "数据 GPIO"
            default 38

        config BSP_I2C_GPIO_SCL
            int "时钟 GPIO"
            default 39

        config BSP_I2C_HZ
            int "总线时钟频率（Hz）"
            default 100000

        config BSP_I2C_GLITCH_IGNORE_CNT
            int "尖峰滤波周期数"
            range 0 30
            default 7

    endmenu

    menu "可选子系统"

        config BSP_ENABLE_TOUCH
            bool "触摸（ST77922 内置控制器）"
            default n
            help
                I2C 从地址 0x55，与音频编解码共用 I2C 总线。
                协议依据厂商 ST77922_TOUCH 库，逐项对应其寄存器定义，
                见 components/bsp/src/bsp_touch.c。

        config BSP_TOUCH_GPIO_RST
            int "复位 GPIO"
            depends on BSP_ENABLE_TOUCH
            default 48

        config BSP_TOUCH_GPIO_INT
            int "中断 GPIO"
            depends on BSP_ENABLE_TOUCH
            default 47

        config BSP_ENABLE_RGB
            bool "RGB 指示灯（WS2812B）"
            default n
            help
                型号 XL-5050RGBC-WS2812B，单线数据引脚 IO40，
                经 Espressif led_strip 组件驱动。

        config BSP_RGB_GPIO
            int "数据 GPIO"
            depends on BSP_ENABLE_RGB
            default 40

        config BSP_ENABLE_AUDIO
            bool "音频（ES8311 + FM8002E 功放）"
            default n
            help
                经 Espressif esp_codec_dev 组件驱动，不手写编解码寄存器。
                编解码 I2C 从地址 0x18，与触摸共用 I2C 总线。

        config BSP_AUDIO_I2S_MCLK
            int "I2S 主时钟 GPIO"
            depends on BSP_ENABLE_AUDIO
            default 17

        config BSP_AUDIO_I2S_BCLK
            int "I2S 位时钟 GPIO"
            depends on BSP_ENABLE_AUDIO
            default 18

        config BSP_AUDIO_I2S_WS
            int "I2S 声道选择 GPIO"
            depends on BSP_ENABLE_AUDIO
            default 21

        config BSP_AUDIO_I2S_DOUT
            int "I2S 数据输出 GPIO（主控 → 编解码）"
            depends on BSP_ENABLE_AUDIO
            default 15

        config BSP_AUDIO_I2S_DIN
            int "I2S 数据输入 GPIO（编解码 → 主控）"
            depends on BSP_ENABLE_AUDIO
            default 16

        config BSP_AUDIO_PA_GPIO
            int "功放使能 GPIO（低电平使能）"
            depends on BSP_ENABLE_AUDIO
            default 1

        config BSP_AUDIO_SAMPLE_RATE
            int "采样率（Hz）"
            depends on BSP_ENABLE_AUDIO
            default 16000

        config BSP_ENABLE_BATTERY
            bool "电池电压检测（ADC）"
            default n
            help
                IO8 经 2:1 分压接入 ADC，实际电压为读数两倍。
                验证状态：未验证 —— 需接入电池。

        config BSP_BATTERY_ADC_UNIT
            int "ADC 单元（1 或 2）"
            depends on BSP_ENABLE_BATTERY
            range 1 2
            default 1

        config BSP_BATTERY_ADC_CHANNEL
            int "ADC 通道（IO8 对应通道 7）"
            depends on BSP_ENABLE_BATTERY
            range 0 9
            default 7

        config BSP_ENABLE_SDCARD
            bool "MicroSD（SDIO 4 位）"
            default n
            help
                验证状态：未验证 —— 需插入 SD 卡。
                注意数据线 DATA3 落在启动配置引脚 GPIO3 上，
                见规格书 01-hardware.md 第 2.9 节。

        config BSP_SD_GPIO_CLK
            int "SDIO 时钟 GPIO"
            depends on BSP_ENABLE_SDCARD
            default 5

        config BSP_SD_GPIO_CMD
            int "SDIO 命令 GPIO"
            depends on BSP_ENABLE_SDCARD
            default 4

        config BSP_SD_GPIO_D0
            int "SDIO 数据 0 GPIO"
            depends on BSP_ENABLE_SDCARD
            default 6

        config BSP_SD_GPIO_D1
            int "SDIO 数据 1 GPIO"
            depends on BSP_ENABLE_SDCARD
            default 7

        config BSP_SD_GPIO_D2
            int "SDIO 数据 2 GPIO"
            depends on BSP_ENABLE_SDCARD
            default 2

        config BSP_SD_GPIO_D3
            int "SDIO 数据 3 GPIO"
            depends on BSP_ENABLE_SDCARD
            default 3

    endmenu

endmenu
